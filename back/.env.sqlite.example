# =====================================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL CON SQLITE
# =====================================================
# Copia este archivo como `.env` (o `.env.local`) para probar el backend
# SIN depender de Supabase. No necesitas internet ni credenciales cloud.
#
#   Windows (PowerShell):
#     Copy-Item .env.sqlite.example .env
#     .\venv\Scripts\python.exe -m uvicorn app.main:app --reload --port 8000
#
# La base de datos se crea automáticamente en `./zenth_local.db` al arrancar.
# =====================================================

# ---------- BASE DE DATOS (SQLite local) ----------
# Al empezar con `sqlite://` el backend entra en modo local automáticamente.
SUPABASE_DATABASE_URL=sqlite:///./zenth_local.db

# Estas variables las exige config.py aunque uses SQLite.
# Pueden quedar con valores dummy.
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=zenth_local
SUPABASE_DB_USER=local
SUPABASE_DB_PASSWORD=local

# ---------- SEGURIDAD ----------
# Obligatoria (>= 16 caracteres). Cambia esto por algo propio.
JWT_SECRET_KEY=cambia-esta-clave-por-una-segura-de-32-chars

# ---------- ENTORNO ----------
ENVIRONMENT=development
DEBUG=True

# ---------- BOOTSTRAP DEL ADMIN (opcional) ----------
# Necesarias SOLO si vas a llamar a POST /api/v1/auth/seed/admin
# para crear el primer administrador. Deben tener >= 12 caracteres.
# BOOTSTRAP_KEY=mi-llave-de-bootstrap-local
# ADMIN_BOOTSTRAP_PASSWORD=MiPasswordSegura123!


# =====================================================
# LOGIN SOCIAL (OAuth) - Google / Microsoft
# =====================================================
# Si dejas estas variables vacias, el boton correspondiente NO se muestra.
# El sistema funciona igual con email/contrasena.
#
# --- GOOGLE ---
# 1) https://console.cloud.google.com/apis/credentials
# 2) "Crear credenciales" > "ID de cliente de OAuth" > "Aplicacion web"
# 3) URI de redireccionamiento autorizado:
#      http://localhost:8000/api/v1/auth/oauth/google/callback
#    (en produccion: https://TU-BACKEND/api/v1/auth/oauth/google/callback)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
#
# --- MICROSOFT ---
# 1) https://portal.azure.com > "Registros de aplicaciones" > "Nuevo registro"
# 2) Tipo de cuenta: "Cuentas en cualquier directorio organizacional y personales"
# 3) URI de redireccionamiento (Web):
#      http://localhost:8000/api/v1/auth/oauth/microsoft/callback
# MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MICROSOFT_CLIENT_SECRET=xxxx~xxxx
# MICROSOFT_TENANT=common
#
# --- URLS ---
# URL publica del backend (para construir el redirect_uri)
BACKEND_PUBLIC_URL=http://localhost:8000
# URL del frontend a la que volvemos tras autenticar
FRONTEND_URL=http://localhost:5173
